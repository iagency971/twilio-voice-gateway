{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E_INTRINSIC_SNAPSHOT_V1 ledger row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id","episode_seq","snapshot_time_utc","session_date_ny","display_slot_rank",
    "current_family","origin_family","center","zlo","zhi","v_snapshot","zone_width_v",
    "episode_age_c5","is_new_episode","prior_snapshot_time_utc","prior_display_slot_rank",
    "family_changed","center_shift_v","zlo_shift_v","zhi_shift_v","row_sha256"
  ],
  "properties": {
    "episode_id": {"type":"string","pattern":"^EIV1-[0-9]{8}$"},
    "episode_seq": {"type":"integer","minimum":1},
    "snapshot_time_utc": {"type":"string","format":"date-time"},
    "session_date_ny": {"type":"string","format":"date"},
    "display_slot_rank": {"type":"integer","minimum":1,"maximum":3,"description":"QA/display metadata only; NOT a quality feature."},
    "current_family": {"type":"string"},
    "origin_family": {"type":"string"},
    "center": {"type":"number"},
    "zlo": {"type":"number"},
    "zhi": {"type":"number"},
    "v_snapshot": {"type":"number","exclusiveMinimum":0},
    "zone_width_v": {"type":"number","minimum":0},
    "episode_age_c5": {"type":"integer","minimum":1},
    "is_new_episode": {"type":"integer","enum":[0,1]},
    "prior_snapshot_time_utc": {"type":["string","null"],"format":"date-time"},
    "prior_display_slot_rank": {"type":["integer","null"],"minimum":1,"maximum":3},
    "family_changed": {"type":"integer","enum":[0,1]},
    "center_shift_v": {"type":["number","null"]},
    "zlo_shift_v": {"type":["number","null"]},
    "zhi_shift_v": {"type":["number","null"]},
    "row_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
